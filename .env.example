# AeroCold Intelligence Platform Environment Configuration

# Google Gemini API Key for autonomous cold-chain risk reasoning
# Obtain from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Maps Platform Server-side API Key for Routes API transit calculations
# Enable 'Routes API' in Google Cloud Console: https://console.cloud.google.com/
GOOGLE_MAPS_SERVER_API_KEY=

# Google Maps Platform Client-side API Key for browser map rendering (optional)
VITE_GOOGLE_MAPS_API_KEY=

# Database connection URL (Default: SQLite local database)
DATABASE_URL=sqlite:///./aerocold.db

# Demo Mode toggle: When true, allows running complete end-to-end simulation without external API keys
DEMO_MODE=true
